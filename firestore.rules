rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // ---- quem é quem ----
    function signedIn() { return request.auth != null; }
    function authed() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function profilePath() { return /databases/$(db)/documents/users/$(request.auth.uid); }
    function hasProfile() { return authed() && exists(profilePath()); }
    function me() { return get(profilePath()).data; }
    function active() { return hasProfile() && me().active == true; }
    // "família": responsável cadastrado, ou tia/tio que também é responsável por uma família
    function isPais() { return active() && me().role in ['pais', 'tia'] && me().get('fam', '') != ''; }
    function isTia() { return active() && me().role == 'tia'; }
    function isStaff() { return active() && me().role in ['recepcao', 'coord', 'admin']; }
    function isManager() { return active() && me().role in ['coord', 'admin']; }
    function isAdmin() { return active() && me().role == 'admin'; }
    function myFam() { return me().get('fam', ''); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---- validação de dados (vale também para o que o visitante grava sozinho) ----
    function okId(id) { return id.matches('[A-Za-z0-9_-]{1,40}'); }
    function str(v, n) { return v is string && v.size() <= n; }
    function openNow() { return get(/databases/$(db)/documents/config/main).data.get('open', true) == true; }

    // Primeiro acesso: enquanto config/main não existe, o primeiro administrador pode se criar.
    function configPath() { return /databases/$(db)/documents/config/main; }
    function bootstrapping() {
      return authed() && !exists(configPath()) && getAfter(configPath()).data.bootstrapped == true;
    }

    // ---- contas ----
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid || isStaff();
      allow create: if (bootstrapping() && request.auth.uid == uid && request.resource.data.role == 'admin' && request.resource.data.active == true)
        || (isAdmin() && request.resource.data.id == uid && request.resource.data.active == true)
        || (isStaff() && request.resource.data.id == uid && request.resource.data.role == 'pais' && request.resource.data.active == true)
        // tia ou tio se cadastra sozinho, mas a conta nasce desativada e pendente até o administrador autorizar
        || (authed() && request.auth.uid == uid && request.resource.data.id == uid && request.resource.data.role == 'tia'
            && request.resource.data.active == false && request.resource.data.get('pending', false) == true
            && request.resource.data.keys().hasOnly(['id', 'role', 'name', 'login', 'active', 'pending', 'tia', 'fam'])
            && str(request.resource.data.name, 80) && str(request.resource.data.login, 100)
            && request.resource.data.get('tia', '') == '' && request.resource.data.get('fam', '') == '');
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (isStaff() && resource.data.role == 'pais' && changed().hasOnly(['active', 'replaced']))
        // a própria pessoa registra o consentimento de fotos
        || (active() && request.auth.uid == uid && changed().hasOnly(['prefs'])
            && request.resource.data.prefs.keys().hasOnly(['fotos']) && request.resource.data.prefs.fotos is bool);
    }

    // ---- abertura do check-in, contagem por sala e histórico (lido até por visitantes) ----
    match /config/main {
      allow get: if true;
      allow create: if bootstrapping();
      allow update: if isStaff() || (isTia() && changed().hasOnly(['counts']));
    }

    match /rooms/{id} {
      allow read: if signedIn();
      allow create: if isManager() || bootstrapping();
      allow update: if isManager();
    }
    match /tias/{id} {
      allow read: if active();
      allow create, update, delete: if isManager();
    }
    match /events/{id} {
      allow read: if active();
      allow create, update, delete: if isManager();
    }

    // ---- famílias, crianças e avisos ----
    match /families/{id} {
      allow read: if isStaff() || isTia()
        || (isPais() && myFam() == id)
        || (signedIn() && resource.data.get('owner', '') == request.auth.uid);
      allow create: if (isStaff() && okId(id))
        || (signedIn() && okId(id) && request.resource.data.visitor == true && request.resource.data.owner == request.auth.uid
            && request.resource.data.keys().hasOnly(['id', 'name', 'visitor', 'owner', 'phone', 'guardians'])
            && request.resource.data.keys().hasAll(['name', 'visitor', 'owner', 'guardians'])
            && str(request.resource.data.name, 80) && str(request.resource.data.get('phone', ''), 30)
            && request.resource.data.guardians is list && request.resource.data.guardians.size() == 1
            && str(request.resource.data.guardians[0], 100));
      allow update, delete: if isStaff();
    }

    match /kids/{id} {
      allow read: if isStaff() || isTia()
        || (isPais() && resource.data.fam == myFam())
        || (signedIn() && resource.data.get('owner', '') == request.auth.uid);
      // o visitante só cria a própria criança, em uma família que ele mesmo criou e com o check-in aberto
      allow create: if (isStaff() && okId(id))
        || (signedIn() && okId(id) && openNow()
            && request.resource.data.visitor == true && request.resource.data.owner == request.auth.uid && request.resource.data.status == 'in'
            && request.resource.data.keys().hasOnly(['id', 'name', 'age', 'room', 'fam', 'owner', 'note', 'obs', 'status', 'time', 'out', 'by', 'code', 'visitor', 'day'])
            && request.resource.data.keys().hasAll(['name', 'room', 'fam', 'owner', 'status', 'visitor'])
            && str(request.resource.data.name, 80) && str(request.resource.data.get('age', ''), 30)
            && str(request.resource.data.get('note', ''), 300) && str(request.resource.data.get('obs', ''), 300)
            && str(request.resource.data.get('by', ''), 100) && str(request.resource.data.get('code', ''), 20)
            && str(request.resource.data.get('time', ''), 5) && str(request.resource.data.get('out', ''), 5) && str(request.resource.data.get('day', ''), 10)
            && exists(/databases/$(db)/documents/rooms/$(request.resource.data.room))
            && getAfter(/databases/$(db)/documents/families/$(request.resource.data.fam)).data.get('owner', '') == request.auth.uid);
      allow delete: if isStaff();
      allow update: if isStaff()
        // a tia só mexe na presença (check-in, check-out e troca de sala)
        || (isTia() && changed().hasOnly(['status', 'time', 'out', 'by', 'day', 'pick', 'room', 'moved']))
        // o responsável só faz o check-in dos próprios filhos, e só com o check-in aberto
        || (isPais() && resource.data.fam == myFam() && request.resource.data.fam == resource.data.fam
            && changed().hasOnly(['status', 'time', 'out', 'by', 'day'])
            && resource.data.status == 'out' && request.resource.data.status == 'in' && openNow())
        // o responsável troca a foto do próprio filho (imagem pequena)
        || (isPais() && resource.data.fam == myFam() && request.resource.data.fam == resource.data.fam
            && changed().hasOnly(['photo']) && str(request.resource.data.photo, 30000));
    }

    match /alerts/{id} {
      allow read: if isStaff() || isTia()
        || (isPais() && resource.data.fam == myFam())
        || (signedIn() && exists(/databases/$(db)/documents/families/$(resource.data.fam))
            && get(/databases/$(db)/documents/families/$(resource.data.fam)).data.get('owner', '') == request.auth.uid);
      allow create: if (isStaff() || isTia()) && okId(id)
        && request.resource.data.keys().hasOnly(['id', 'at', 'fam', 'kid', 'text', 'time', 'reply', 'seen', 'by'])
        && str(request.resource.data.text, 500);
      allow update: if ((isStaff() || isTia()) && changed().hasOnly(['seen', 'reply']))
        || (isPais() && resource.data.fam == myFam() && changed().hasOnly(['seen', 'reply']))
        || (signedIn() && exists(/databases/$(db)/documents/families/$(resource.data.fam))
            && get(/databases/$(db)/documents/families/$(resource.data.fam)).data.get('owner', '') == request.auth.uid
            && changed().hasOnly(['seen', 'reply']));
    }

    // ---- aparelhos dos pais inscritos nos avisos ----
    match /pushsubs/{id} {
      allow read: if isStaff() || isTia();
      allow create: if isPais() && request.resource.data.owner == request.auth.uid && request.resource.data.fam == myFam()
        && request.resource.data.keys().hasOnly(['fam', 'owner', 'sub', 'at']) && str(request.resource.data.sub, 3000);
      allow update: if isPais() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid && request.resource.data.fam == myFam()
        && request.resource.data.keys().hasOnly(['fam', 'owner', 'sub', 'at']) && str(request.resource.data.sub, 3000);
      allow delete: if isStaff() || isTia() || (isPais() && resource.data.owner == request.auth.uid);
    }

    // ---- registro de ações: só quem tem acesso ativo escreve, só o administrador lê ----
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if active() && okId(id)
        && request.resource.data.keys().hasOnly(['id', 'at', 't', 'who', 'text'])
        && str(request.resource.data.text, 300) && str(request.resource.data.who, 80);
    }
  }
}
